rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todo lo escribe/lee el backend con el Admin SDK (que ignora estas reglas).
    // El cliente (navegador) no necesita leer/escribir Firestore directo en esta demo,
    // así que se bloquea todo por defecto. Si más adelante quieres que el usuario
    // lea SU PROPIO comprobante desde el navegador, añade algo como:
    //
    // match /signedDocuments/{docId} {
    //   allow read: if request.auth != null && request.auth.uid == resource.data.userDocId;
    // }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
