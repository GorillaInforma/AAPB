{
  "version": 2,
  "functions": {
    "api/generar-pdf.js": {
      "memory": 1024,
      "maxDuration": 45
    }
  },
  "routes": [
    { "src": "/A3CC.EquipoNo.3/api/(.*)", "dest": "/api/$1" },
    { "src": "/A3CC.EquipoNo.3/(.*)",     "dest": "/public/$1" },
    { "src": "/A3CC.EquipoNo.3",          "dest": "/public/index.html" },
    { "src": "/api/(.*)",                  "dest": "/api/$1" },
    { "src": "/(.*)",                      "dest": "/public/$1" }
  ]
}
